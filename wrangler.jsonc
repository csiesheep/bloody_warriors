{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloody_warriors",
  "compatibility_date": "2026-10-04",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "games.csiesheep.com/bloody_warriors",
      "zone_name": "csiesheep.com"
    },
    {
      "pattern": "games.csiesheep.com/bloody_warriors/*",
      "zone_name": "csiesheep.com"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
